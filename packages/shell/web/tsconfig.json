{
  "extends": "../../tsconfig/library.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@worken/ir/*": ["../ir/src/*"],
      "@worken/shell-web/*": ["./src/*"],
      "@worken/demo/*": ["../../../examples/demo/*"],
      "@/components/*": ["../../../apps/landing/src/components/*"],
      "@/lib/*": ["../../../apps/landing/src/lib/*"],
      "@/execution/*": ["../../../apps/landing/src/execution/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
