{
  "name": "@worken/dsl-app",
  "version": "0.0.1",
  "private": true,
  "description": "Single-entry Worken application DSL (compiles to @worken/dsl)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint src"
  },
  "dependencies": {
    "@worken/dsl": "workspace:*"
  },
  "devDependencies": {
    "@worken/tsconfig": "workspace:*",
    "typescript": "^5.9.3"
  }
}
