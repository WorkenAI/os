{
	"name": "@worken/code-graph",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Build Worken-style code IR from TypeScript compiler (exports, imports, package deps)",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist .turbo",
		"lint": "biome lint src",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"test": "node --import tsx --test src/**/*.test.ts"
	},
	"dependencies": {
		"@worken/platform-core": "workspace:*",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@worken/tsconfig": "workspace:*",
		"tsx": "^4.19.2"
	}
}
