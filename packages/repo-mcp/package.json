{
	"name": "@worken/repo-mcp",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Scan the Worken OS monorepo and serve it as MCP model context",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist .turbo",
		"lint": "biome lint src",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"test": "node --import tsx --test src/**/*.test.ts",
		"mcp": "bun run ./src/mcp-stdio.ts"
	},
	"dependencies": {
		"@worken/code-graph": "workspace:*",
		"@worken/platform-core": "workspace:*",
		"@worken/platform-mcp": "workspace:*",
		"@worken/semantic-core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@worken/context-core": "workspace:*",
		"@worken/semantic-ir": "workspace:*",
		"@worken/tsconfig": "workspace:*",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3"
	}
}
